{
    "name": "@usesequential/cli",
    "version": "0.1.3",
    "description": "The Sequential command line: record changes and releases from any CI or shell, and call every Sequential agent tool from scripts.",
    "keywords": [
        "sequential",
        "cli",
        "session replay",
        "analytics",
        "mcp",
        "release",
        "changes"
    ],
    "homepage": "https://github.com/usesequential/sequential-cli#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/usesequential/sequential-cli.git"
    },
    "bugs": {
        "url": "https://github.com/usesequential/sequential-cli/issues"
    },
    "type": "commonjs",
    "bin": {
        "sequential": "dist/bin.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "sideEffects": false,
    "scripts": {
        "build": "node scripts/build.cjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsc -p tsconfig.json && node scripts/build.cjs && node scripts/test.cjs",
        "smoke": "node scripts/smoke.cjs",
        "prepublishOnly": "node scripts/build.cjs && node scripts/smoke.cjs"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/node": "22.20.4",
        "typescript": "5.7.3"
    }
}
